
import csv
import math
import statistics
import html

# ============================================
# MT2013 - TASK 1: ESTIMATION
# Report: exactly 3 designed pages
# Variable: price (USD)
# ============================================

INPUT_FILE = "kc_house_data_cleaned.csv"
OUTPUT_HTML = "Task_1_Estimation_Report.html"
OUTPUT_CSV = "Task_1_Results.csv"


# ---------- 1. READ DATA ----------

prices = []

try:
    with open(INPUT_FILE, "r", encoding="utf-8-sig") as f:
        reader = csv.DictReader(f)

        if not reader.fieldnames or "price" not in reader.fieldnames:
            raise ValueError("Column 'price' was not found.")

        for row in reader:
            try:
                value = float(row["price"])

                if math.isfinite(value) and value > 0:
                    prices.append(value)

            except (ValueError, TypeError):
                continue

except FileNotFoundError:
    print("ERROR: Please upload kc_house_data_cleaned.csv")
    raise SystemExit


n = len(prices)

if n < 31:
    print("ERROR: At least 31 valid observations are required.")
    raise SystemExit


# ---------- 2. DESCRIPTIVE STATISTICS ----------

mean_price = statistics.mean(prices)
median_price = statistics.median(prices)
std_price = statistics.stdev(prices)

minimum = min(prices)
maximum = max(prices)

sorted_prices = sorted(prices)


def percentile(data, p):
    position = (len(data) - 1) * p
    lower = int(position)
    upper = min(lower + 1, len(data) - 1)
    fraction = position - lower

    return data[lower] + fraction * (
        data[upper] - data[lower]
    )


q1 = percentile(sorted_prices, 0.25)
q3 = percentile(sorted_prices, 0.75)
iqr = q3 - q1

lower_fence = q1 - 1.5 * iqr
upper_fence = q3 + 1.5 * iqr

outlier_count = sum(
    1 for x in prices
    if x < lower_fence or x > upper_fence
)


# ---------- 3. POINT ESTIMATION ----------

standard_error = std_price / math.sqrt(n)


# ---------- 4. 95% CONFIDENCE INTERVAL ----------

# Large-sample approximation to Student's t critical value.
# Appropriate for the large King County housing dataset.

df = n - 1
z = 1.959963984540054

t_critical = (
    z
    + (z**3 + z) / (4 * df)
    + (5*z**5 + 16*z**3 + 3*z) / (96 * df**2)
    + (3*z**7 + 19*z**5 + 17*z**3 - 15*z)
      / (384 * df**3)
)

margin_error = t_critical * standard_error

lower_ci = mean_price - margin_error
upper_ci = mean_price + margin_error


# ---------- 5. FORMATTING FUNCTIONS ----------

def usd(x):
    return f"${x:,.2f}"


def number(x):
    return f"{x:,.2f}"


# ---------- 6. EXPORT NUMERICAL RESULTS ----------

with open(OUTPUT_CSV, "w", newline="", encoding="utf-8") as f:
    writer = csv.writer(f)

    writer.writerow(["Statistic", "Value", "Unit"])
    writer.writerow(["Sample size", n, "observations"])
    writer.writerow(["Sample mean", mean_price, "USD"])
    writer.writerow(["Sample standard deviation", std_price, "USD"])
    writer.writerow(["Median", median_price, "USD"])
    writer.writerow(["Minimum", minimum, "USD"])
    writer.writerow(["Maximum", maximum, "USD"])
    writer.writerow(["Q1", q1, "USD"])
    writer.writerow(["Q3", q3, "USD"])
    writer.writerow(["IQR", iqr, "USD"])
    writer.writerow(["Potential outliers", outlier_count, "observations"])
    writer.writerow(["Standard error", standard_error, "USD"])
    writer.writerow(["t critical (approximation)", t_critical, ""])
    writer.writerow(["Margin of error", margin_error, "USD"])
    writer.writerow(["Lower confidence limit", lower_ci, "USD"])
    writer.writerow(["Upper confidence limit", upper_ci, "USD"])


